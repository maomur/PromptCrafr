
{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Represents a folder or project for organizing prompts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      },
      "required": ["id", "name", "createdAt", "ownerId"]
    },
    "Prompt": {
      "title": "Prompt",
      "description": "Represents a single AI prompt owned by a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string", "enum": ["Video", "Imagen", "Textos", "Otros"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "projectId": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["id", "title", "content", "category", "createdAt", "updatedAt", "ownerId"]
    }
  },
  "auth": {
    "providers": ["anonymous", "password"]
  },
  "firestore": {
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/backend/entities/Project" },
      "description": "User-specific projects for prompt organization."
    },
    "/users/{userId}/prompts/{promptId}": {
      "schema": { "$ref": "#/backend/entities/Prompt" },
      "description": "User-specific AI prompts."
    }
  }
}
